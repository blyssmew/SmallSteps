<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default typography -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.app-name">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="TextBlock.navigation-label">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.wrapped">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Page-specific but reusable greeting hierarchy -->
    <Style Selector="TextBlock.welcome-message">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.item-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Emoji / glyph icons share alignment; classes set size and spacing -->
    <Style Selector="TextBlock.visual-icon">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.item-icon">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <Style Selector="TextBlock.tracker-icon">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style Selector="TextBlock.status-indicator">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style Selector="TextBlock.date-label">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

</Styles>
