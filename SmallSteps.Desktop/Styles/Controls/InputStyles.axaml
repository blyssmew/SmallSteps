<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared text-input typography and appearance -->
    <Style Selector="TextBox.text-input">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox.text-input:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="TextBox.text-input:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBox.multiline-input">
        <Setter Property="Height" Value="70" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style Selector="CheckBox.form-checkbox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Star rating display; interaction will be wired through a control later -->
    <Style Selector="TextBlock.rating-star">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="TextBlock.rating-star.empty">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

</Styles>
