<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default elevated card -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #08000000" />
    </Style>

    <!-- Compact cards use less padding, not a separate card design -->
    <Style Selector="Border.card.compact">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.card.accent">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Inset panels inside a card; intentionally not elevated -->
    <Style Selector="Border.inset-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

</Styles>
